Options -Indexes
DirectoryIndex index.html

# This document root contains only the static landing, never PHP applications.
<FilesMatch "\.(?:php[0-9]?|phtml|phar)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

RewriteEngine On

# Normalize the home page in one hop on the two landing hosts only.
RewriteCond %{HTTP_HOST} ^(?:www\.)?(?:orcamento|equipamentos)\.venezapiscinas\.com\.br$ [NC]
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ https://equipamentos.venezapiscinas.com.br/ [R=301,L,NE]

# Installed in the old root after the new HTTPS landing is verified.
# Keep each path and query string; never redirect institutional/PENA/shop hosts.
RewriteCond %{HTTP_HOST} ^(?:www\.)?(?:orcamento|equipamentos)\.venezapiscinas\.com\.br$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^equipamentos\.venezapiscinas\.com\.br$ [NC]
RewriteRule ^ https://equipamentos.venezapiscinas.com.br%{REQUEST_URI} [R=301,L,NE]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php84" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
