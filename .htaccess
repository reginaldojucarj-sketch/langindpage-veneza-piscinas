Options -Indexes
DirectoryIndex index.html

# This document root contains only the static landing, never PHP applications.
<FilesMatch "\.(?:php[0-9]?|phtml|phar)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

RewriteEngine On

<IfModule mod_headers.c>
  <If "%{HTTP_HOST} =~ m#^(?:www\.)?(?:equipamentos|orcamento)\.venezapiscinas\.com\.br\.?(:[0-9]+)?$#i">
    Header always set Strict-Transport-Security "max-age=604800" "expr=%{HTTPS} == 'on'"
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' https://www.googletagmanager.com/gtag/; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://pena.venezapiscinas.com.br https://venezapiscinas.com.br https://www.venezapiscinas.com.br https://www.google.com https://www.google.com.br https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com; media-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src https://www.google.com https://www.google.com.br https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com https://ad.doubleclick.net"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/xml
  </IfModule>
</IfModule>

# Normalize the home page in one hop on the two landing hosts only.
RewriteCond %{HTTP_HOST} ^(?:www\.)?(?:orcamento|equipamentos)\.venezapiscinas\.com\.br$ [NC]
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ https://equipamentos.venezapiscinas.com.br/ [R=301,L,NE]

# Installed in the old root after the new HTTPS landing is verified.
# Keep each path and query string; never redirect institutional/PENA/shop hosts.
RewriteCond %{HTTP_HOST} ^(?:www\.)?(?:orcamento|equipamentos)\.venezapiscinas\.com\.br$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^equipamentos\.venezapiscinas\.com\.br$ [NC]
RewriteRule ^ https://equipamentos.venezapiscinas.com.br%{REQUEST_URI} [R=301,L,NE]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php84" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
